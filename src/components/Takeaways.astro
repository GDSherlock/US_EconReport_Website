---
import {textFor} from '../lib/i18n.mjs';
interface Props { locale?: string; items: { title: string; text: string }[]; }
const { items, locale='zh' } = Astro.props;
const t=(zh:string,en:string)=>textFor(locale,zh,en);
---
<section class="takeaways" aria-labelledby="key-takeaways">
  <div class="section-heading"><h2 id="key-takeaways">{t('本周核心判断','Key takeaways')}</h2><span class="section-english">THE WEEK IN FOCUS</span></div>
  <ol>
    {items.map((item, index) => <li><span class="takeaway-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><div><h3>{item.title}</h3><p>{item.text}</p></div></li>)}
  </ol>
</section>
