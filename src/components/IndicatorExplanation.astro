---
import {getIndicatorGuide,validateIndicatorGuide} from '../lib/indicator-guides.mjs';
import {renderIndicatorExplanation} from '../lib/indicator-explanation.mjs';
interface Props { chart: {chartId:string; panels:any[]}; }
const {chart}=Astro.props;
const guide=validateIndicatorGuide(chart,getIndicatorGuide(chart.chartId));
---
<Fragment set:html={renderIndicatorExplanation(guide,chart.chartId)} />
