---
import ReportLayout from '../../layouts/ReportLayout.astro';
import { getReports } from '../../lib/reports';
const {locale='zh'}=Astro.props;
const [latest] = await getReports();
if (!latest) throw new Error('No published report. Add a Markdown report with draft: false to src/content/reports/.');
---
<ReportLayout report={latest} isHome locale={locale} />
